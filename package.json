{
  "name": "onyx-smart-accounting",
  "version": "1.1.0",
  "description": "ONYX Smart Accounting - Arabic-first local accounting application",
  "main": "main.js",
  "author": "ONYX Smart Accounting",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "prepare:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['smart-accountant.html','accounting-core.js'])fs.copyFileSync(f,'www/'+(f==='smart-accountant.html'?'index.html':f));\"",
    "build:android": "npm run test && npm run prepare:web && npx cap sync android",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.onyx.smartaccounting",
    "productName": "ONYX Smart Accounting",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "smart-accountant.html",
      "accounting-core.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
