{
  "name": "smart-accountant",
  "version": "1.0.1",
  "description": "تطبيق محاسب الذكي",
  "main": "main.js",
  "author": "Smart Accountant",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smartaccountant.desktop",
    "productName": "Smart Accountant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "smart-accountant.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
